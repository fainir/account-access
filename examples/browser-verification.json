{
  "version": 1,
  "accounts": {
    "example-account": {
      "kind": "browser",
      "label": "Example browser account — connector template",
      "login_url": "https://account.example/login",
      "ready_selector": "#signed-in",
      "login": {
        "username_selector": "#username",
        "password_selector": "#password",
        "submit_selector": "#sign-in",
        "choices": [
          {"kind": "totp", "selector": "a#use-authenticator", "url": "https://account.example/verify/authenticator"},
          {"kind": "sms", "selector": "a#use-sms", "url": "https://account.example/verify/sms"},
          {"kind": "email", "selector": "a#use-email", "url": "https://account.example/verify/email"}
        ],
        "factors": {
          "email": {
            "code_source": "example-email",
            "code_selector": "#email-code",
            "code_submit_selector": "#verify-email"
          },
          "sms": {
            "code_source": "example-sms",
            "code_selector": "#sms-code",
            "code_submit_selector": "#verify-sms"
          },
          "totp": {
            "code_source": "example-authenticator",
            "code_selector": "#authenticator-code",
            "code_submit_selector": "#verify-authenticator"
          }
        }
      },
      "challenge_selectors": {
        "login": "#password-login",
        "method": "#verification-method-choice",
        "email": "#email-verification",
        "sms": "#sms-verification",
        "totp": "#authenticator-verification",
        "action": "#payment-approval",
        "passkey": "#passkey-required"
      },
      "read_resources": ["https://account.example/login"],
      "login_resources": [
        "https://account.example/login",
        "https://account.example/verify/method",
        "https://account.example/verify/email",
        "https://account.example/verify/sms",
        "https://account.example/verify/authenticator",
        "https://account.example/summary"
      ],
      "login_post_urls": [
        "https://account.example/login",
        "https://account.example/verify/email",
        "https://account.example/verify/sms",
        "https://account.example/verify/authenticator"
      ],
      "operations": {
        "summary": {
          "kind": "browser",
          "description": "Read the signed-in page heading",
          "url": "https://account.example/summary",
          "fields": {"heading": "h1"}
        }
      }
    }
  },
  "code_sources": {
    "example-email": {
      "kind": "imap",
      "host": "imap.gmail.com",
      "sender": "login@account.example",
      "recipient": "owner@example.com",
      "subject": "Your example sign-in code",
      "template": "Your sign-in code: {code}"
    },
    "example-sms": {
      "kind": "mac_messages",
      "sender": "Example",
      "recipient": "owner-phone",
      "template": "Example sign-in: {code}"
    },
    "example-authenticator": {"kind": "totp"}
  }
}
