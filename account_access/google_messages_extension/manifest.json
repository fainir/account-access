{
  "manifest_version": 3,
  "name": "Account Access \u2014 Login SMS",
  "version": "0.8.0",
  "description": "Pass fresh approved GitHub login texts from your paired Google Messages tab to Account Access locally.",
  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://messages.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "key": ""
}
